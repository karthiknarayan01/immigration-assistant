# ── Local model server (Ollama) ───────────────────────────────────────────────
# Start Ollama first: ollama serve
OLLAMA_API_BASE=http://localhost:11434

# Model assignments — all free, all local
# 14b fits fully in GPU memory on a 32GB Mac; 32b spills to CPU and is very slow.
ORCHESTRATOR_MODEL=qwen2.5:14b
SPECIALIST_MODEL=qwen2.5:14b

OLLAMA_NUM_CTX=4096

# ── Optional: enhanced live web search ───────────────────────────────────────
# Free tier at serper.dev gives 2500 searches/month
# Without this key, the agent falls back to direct USCIS scraping
SERPER_API_KEY=your_serper_api_key_here

# ── RAG config ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=8
COMMUNITY_TOP_K=5
