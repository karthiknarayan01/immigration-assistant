# ── Vertex AI ────────────────────────────────────────────────────────────────
# We use Vertex AI rather than a Gemini Developer API (AI Studio) key because
# Google Cloud credits apply to Vertex AI but NOT to AI Studio keys — an
# AI Studio key bills your linked card instead of your credits.

GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east4

# Local development only. Path to a service account JSON with the
# "Vertex AI User" role. Leave BOTH of these blank on Cloud Run, where the
# attached service account is picked up via Application Default Credentials.
GOOGLE_VERTEX_CREDENTIALS_PATH=
# Alternatively the raw JSON as a single-line string (takes precedence):
GOOGLE_VERTEX_CREDENTIALS=

# ── Model ────────────────────────────────────────────────────────────────────
# Vertex model paths are prefixed with "google/".
# NOTE: Gemini 3.8 Live was announced 2026-09-15; confirm its Vertex model id
# and swap it in here once available, then re-measure latency and cost.
GEMINI_MODEL=google/gemini-live-2.5-flash-native-audio

# Voices: Aoede, Charon, Fenrir, Kore, Puck
GEMINI_VOICE=Charon

# ── Turn detection ───────────────────────────────────────────────────────────
# Higher than typical defaults on purpose — most users are non-native English
# speakers who pause mid-sentence, and cutting them off is the worst failure
# mode for this product. Raise further if testing shows interruptions.
VAD_SILENCE_DURATION_MS=1500
VAD_PREFIX_PADDING_MS=300

# ── Search providers ─────────────────────────────────────────────────────────
# Each tool activates only when its key is present. With none set, the agent
# still runs but tells the user it could not check a live source rather than
# guessing at current policy.
#
# Note: uscis.gov returns 403 to datacenter traffic, so official sources are
# reached through these providers' crawlers, never fetched directly.
#
# Start with Tavily ($0.008/search, cheapest) and Exa ($7/1k, better semantic
# matching). The others can wait.
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# xAI, for searching X. Optional but high value: a change in practice — a
# consulate issuing 221(g) in volume, an RFE wave — shows up on X days or
# weeks before it reaches a law firm blog, and months before USCIS.
# Posts are never trusted more than forum posts: they go through the same
# recency, firsthand and three-independent-authors gates.
# Key from https://console.x.ai
XAI_API_KEY=

# Voice has no tolerance for dead air; give up on a slow tool and say so.
TOOL_TIMEOUT_SECS=8.0

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated. Lock this to your Vercel domain before going public.
ALLOWED_ORIGINS=*
PORT=8080
