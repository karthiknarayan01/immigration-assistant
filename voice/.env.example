# ── Model routing ──────────────────────────────────────────────────────────
# The agent talks to any OpenAI-compatible endpoint. OpenRouter is the default:
# one key reaches hundreds of models, with automatic fallback.
#
# The model that answers. Chosen by measurement, not reputation: it must use
# its tools reliably, because a lookup is enforced and some models leak raw
# tool-call tokens into the answer text when it is.
LLM_MODEL=google/gemini-2.5-flash
# Used when the primary model fails transiently (optional):
LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
# A reasoning model for strategy questions. LEAVE BLANK unless a candidate
# measures better: deepseek-r1 was benchmarked here and scored no better while
# calling tools less reliably. Blank means the primary model answers those too.
REASONER_MODEL=
# Judge model used by the evals. Must be stronger than, and unrelated to, the
# agent, or it is marking its own homework.
JUDGE_MODEL=anthropic/claude-sonnet-5.5
# Per-model prices for the eval report's cost column, as JSON. Blank = tokens
# only, no cost (a stale hardcoded price lies quietly).
LLM_PRICES=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# ── Search providers ─────────────────────────────────────────────────────────
# Each tool activates only when its key is present. With none set, the agent
# still runs but tells the user it could not check a live source rather than
# guessing at current policy.
#
# Note: uscis.gov returns 403 to datacenter traffic, so official sources are
# reached through these providers' crawlers, never fetched directly.
#
# Start with Tavily ($0.008/search, cheapest). Exa adds better semantic search.
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# xAI, for searching X. Optional but high value: a change in practice — a
# consulate issuing 221(g) in volume, an RFE wave — shows up on X days or
# weeks before it reaches a law firm blog, and months before USCIS.
XAI_API_KEY=

# ── Budgets ─────────────────────────────────────────────────────────────────
TOOL_TIMEOUT_SECS=12.0
MODEL_TIMEOUT_SECS=60.0

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated. Lock this to your Vercel domain before going public.
ALLOWED_ORIGINS=*
PORT=8080
