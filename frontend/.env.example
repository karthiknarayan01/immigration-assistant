# Base URL of the assistant backend (the Cloud Run URL from
# `gcloud run deploy immigration-assistant`). No trailing slash.
#
# Used server-side by /api/chat to proxy text turns. Set it separately when
# the backend should be reachable from the Vercel function but not published
# to the browser.
#
# For local development against a locally running backend:
#   BACKEND_URL=http://localhost:8080
BACKEND_URL=

# The page itself does not call the backend directly (it goes through
# /api/chat), so this is only needed if the proxy route is bypassed.
NEXT_PUBLIC_BACKEND_URL=
