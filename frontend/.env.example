# Base URL of the voice agent service (the Cloud Run URL from
# `gcloud run deploy immigration-voice`). No trailing slash.
#
# Must be NEXT_PUBLIC_ because the browser opens the /ws socket directly.
# For local development against a locally running voice service:
#   NEXT_PUBLIC_VOICE_SERVICE_URL=http://localhost:8080
NEXT_PUBLIC_VOICE_SERVICE_URL=

# Same service, used server-side by /api/chat to proxy text turns. Optional:
# without it the route falls back to NEXT_PUBLIC_VOICE_SERVICE_URL. Set it
# separately when the service should be reachable from the Vercel function
# but not published to the browser.
VOICE_SERVICE_URL=
