# Base URL of the voice agent service (the Cloud Run URL from
# `gcloud run deploy immigration-voice`). No trailing slash.
# The client appends /api/offer for WebRTC signalling.
#
# Must be NEXT_PUBLIC_ because the browser connects to it directly.
# For local development against a locally running voice service:
#   NEXT_PUBLIC_VOICE_SERVICE_URL=http://localhost:8080
NEXT_PUBLIC_VOICE_SERVICE_URL=
